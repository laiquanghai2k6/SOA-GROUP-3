NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Auth (token chỉ truyền qua cookie HttpOnly - SRS 4.2)
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
CORS_ORIGINS=http://localhost:5173

# Payments
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# Shipping
SHIPPING_FEE_VND=30000
FREE_SHIPPING_THRESHOLD_VND=500000

# Rate limit (request/phút/IP)
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5

# Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345